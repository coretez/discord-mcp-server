# ─── Required ──────────────────────────────────────────────────────────────────

# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token.
# Treat it like a password: it is full authority over everything the bot can reach.
DISCORD_BOT_TOKEN=

# Guild(s) this server may touch. Comma-separated. No default — this is the blast-radius fence.
# FluencySecurityAi:
DISCORD_GUILD_ID=1542903941933826118

# ─── Capability ────────────────────────────────────────────────────────────────

# read  — look only, plus the five server-inspection tools (15 tools)
# write — plus post, edit own, react, pin, thread (20 tools)
# admin — plus channels, roles, moderation (37 tools)
#
# Under stdio this is the mode, full stop. Under http with OAuth enabled it is only
# the fallback for unauthenticated callers; an authenticated caller's tier comes
# from their Discord roles instead.
DISCORD_MODE=read

# Destructive tools (delete message/channel/role, kick, ban, bulk delete) are registered in
# admin mode but refuse to run unless this is true AND the call passes confirm:true.
DISCORD_ALLOW_DESTRUCTIVE=false

# Optional. When set, writes are confined to these channel ids; everything else is read-only.
# DISCORD_CHANNEL_ALLOWLIST=

# Ceiling on discord_bulk_delete_messages, 1-100.
DISCORD_BULK_DELETE_MAX=50

# ─── Transport ─────────────────────────────────────────────────────────────────

# stdio — the client spawns this process (default; local, single operator).
# http  — listen, and serve many clients (hosted).
DISCORD_TRANSPORT=stdio

# http only. Bind loopback and let a reverse proxy terminate TLS.
DISCORD_HTTP_HOST=127.0.0.1
DISCORD_HTTP_PORT=8500

# http only, strongly recommended. Host headers this server will answer to.
# Anything else is refused, which is what stops a browser on someone else's
# machine from driving a loopback-bound server via DNS rebinding. Empty
# disables the check entirely.
# DISCORD_ALLOWED_HOSTS=discord.example.com,127.0.0.1:8500

# ─── Authentication (http only) ────────────────────────────────────────────────

# Set all three to require a Discord login, or none to run unauthenticated.
# The client id is the SAME application as the bot — no second app to create.
# Register <DISCORD_PUBLIC_URL>/auth/discord/callback as a redirect URI on the
# application's OAuth2 page, or Discord rejects the callback.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_PUBLIC_URL=https://discord.example.com

# Role id -> tier, comma-separated, highest tier wins. Safe to leave empty: the
# guild owner still gets DISCORD_OWNER_TIER and any member DISCORD_MEMBER_TIER,
# so authentication works on a guild with no roles defined at all.
# DISCORD_ROLE_TIERS=123456789012345678:write,987654321098765432:admin

# Tier for the guild owner. Ownership is not expressible as a role, so it is
# resolved separately.
# DISCORD_OWNER_TIER=admin

# Tier for an authenticated member matching no role rule.
# DISCORD_MEMBER_TIER=read

# ─── Optional ──────────────────────────────────────────────────────────────────

# Playbooks served by list_skills / load_skill. Defaults to ./skills.
# DISCORD_SKILLS_DIR=

# Where report_client_issue appends receipts. Defaults to ./issues.jsonl.
# Local file only — nothing is sent off the machine.
# DISCORD_ISSUE_LOG=
